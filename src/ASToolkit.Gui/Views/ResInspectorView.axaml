<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ASToolkit.Gui.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="ASToolkit.Gui.Views.ResInspectorView"
             x:DataType="vm:ResInspectorViewModel"
             x:CompileBindings="True">

    <ScrollViewer>
        <StackPanel>
            <Border Margin="5" CornerRadius="10" Background="Gray">
                <TextBlock Margin="5" FontSize="24" HorizontalAlignment="Center" Text="RES File inspector"></TextBlock>
            </Border>

            <Button HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{Binding OpenButtonMargin}"
                    Command="{Binding OpenFileAsync}" Content="Open File">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1.5" ScaleY="1.5"></ScaleTransform>
                </Button.RenderTransform>
            </Button>
            <TreeView Margin="10" ItemsSource="{Binding Nodes}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding SubNodes}">
                        <TextBlock Text="{Binding Title}"/>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
