<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ASToolkit.Gui.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
             x:Class="ASToolkit.Gui.Views.ReplayView"
             x:DataType="vm:ReplayViewModel"
             x:CompileBindings="True">

    <DockPanel>
        <Border Classes="toolbar" DockPanel.Dock="Top">
            <WrapPanel>
                <Button Content="run bot" Command="{Binding RunCommand}" IsEnabled="{Binding !IsRunning}" />
                <CheckBox Content="play" IsChecked="{Binding IsPlaying}" IsEnabled="{Binding IsReady}" />
                <TextBlock Text="speed" />
                <NumericUpDown Value="{Binding Speed}" Minimum="0.1" Maximum="8" Increment="0.5" FormatString="0.0" Width="110" />
                <TextBlock Text="frame" />
                <NumericUpDown Value="{Binding FrameIndex}" Minimum="0" Maximum="{Binding FrameCount}" Increment="1" FormatString="0" Width="120"
                               IsEnabled="{Binding IsReady}" />
            </WrapPanel>
        </Border>

        <Border Classes="status" DockPanel.Dock="Bottom">
            <SelectableTextBlock Text="{Binding Status}" />
        </Border>

        <Slider DockPanel.Dock="Bottom" Minimum="0" Maximum="{Binding FrameCount}" Value="{Binding FrameIndex}" IsEnabled="{Binding IsReady}"
                Margin="8,4" />

        <Panel Background="Black">
            <Image Source="{Binding Frame}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
        </Panel>
    </DockPanel>
</UserControl>
